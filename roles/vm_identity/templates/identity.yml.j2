---
# GENERATED by deevnet.mgmt playbooks/vm-identity.yml - DO NOT EDIT.
#
#   ansible-playbook playbooks/vm-identity.yml -e vm_identity_assign=true
#
# The MAC is a pure function of the VMID, so it is not stored independently -
# it is stored here alongside the VMID it came from, and the audit fails if the
# two ever disagree:
#
#   {{ vm_identity_namespace }} : (vmid >> 16) : (vmid >> 8 & 0xff) : (vmid & 0xff)
#
# The VMID is IDENTITY, not sizing. Change it and the MAC, the DHCP reservation
# and the address all move with it. opnsense_dhcp reconciles by MAC and does NOT
# prune orphans, so DELETE THE OLD RESERVATION on the core router before
# renumbering, or Kea ends up holding two reservations for one address.
#
# See docs/standards/mac-naming and
# docs/runbook/building-recovery/vm-identity.
deevnet_assigned_vmid: {{ identity_vmid }}
deevnet_assigned_mac: "{{ identity_mac }}"
