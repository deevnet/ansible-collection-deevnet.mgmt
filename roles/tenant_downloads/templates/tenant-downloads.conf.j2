# {{ ansible_managed }}
# Tenant downloads (CHG-0025): static and read-only, on loopback. Tenants reach
# it over HTTPS through the host's service proxy (ADR-0036). The only server in
# this container - the image's default port-80 server is not mounted.
server {
    listen {{ tenant_downloads_listen_address }}:{{ tenant_downloads_port }};
    server_name _;

    root /content;
    autoindex on;
    autoindex_exact_size off;
    server_tokens off;
    # Relative redirects: this server does not know the name, scheme or port
    # the tenant dialed at the proxy, and must not put its own in a Location.
    absolute_redirect off;
    add_header X-Content-Type-Options nosniff always;

    # Read-only: anything but GET and HEAD is refused. (limit_except is only
    # allowed inside a location.)
    location / {
        limit_except GET HEAD { deny all; }
    }

    # The Deevnet Root CA (and, during a re-root, the outgoing root), so a
    # computer can fetch it once and check its fingerprint against the tenant
    # guide before trusting anything it signs.
{% for root in tenant_downloads_roots %}
    location = /{{ root | basename }} {
        alias /roots/{{ root | basename }};
        default_type application/x-pem-file;
    }
{% endfor %}
}
