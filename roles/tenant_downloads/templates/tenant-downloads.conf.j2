# {{ ansible_managed }}
# Tenant downloads (CHG-0025): static, read-only, HTTPS only. The only server
# in this container - the image's default port-80 server is not mounted.
server {
    listen {{ tenant_downloads_port }} ssl;
    server_name _;

    ssl_certificate     /tls/cert.pem;
    ssl_certificate_key /tls/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /content;
    autoindex on;
    autoindex_exact_size off;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;

    # Read-only: anything but GET and HEAD is refused. (limit_except is only
    # allowed inside a location.)
    location / {
        limit_except GET HEAD { deny all; }
    }

    # The site root, so a laptop can fetch it once and check its fingerprint
    # against the tenant guide before trusting anything it signs.
{% for name in [tenant_downloads_ca_name] + tenant_downloads_ca_old_names %}
    location = /{{ name }} {
        alias /tls/{{ tenant_downloads_ca_name }};
        default_type application/x-pem-file;
    }
{% endfor %}
}
