# {{ ansible_managed }}
[Unit]
Description=Deevnet backup to the attached drive (CHG-0039)
# Ordering only: the script waits for both to answer, and fails if they do not.
After={{ backup_db_container }}.service {{ backup_state_container }}.service network-online.target

[Service]
Type=oneshot
ExecStart={{ backup_script }}
# A run is seconds. Anything near this is a hung drive.
TimeoutStartSec=900
