# {{ ansible_managed }}
[Unit]
Description=Deevnet backup to the attached drive (CHG-0039)
# Ordering only: the script fails if the database or the state store does not
# answer. The state store is on another host (CHG-0068).
After={{ backup_db_container }}.service network-online.target

[Service]
Type=oneshot
ExecStart={{ backup_script }} --if-due
# A run is seconds. Anything near this is a hung drive.
TimeoutStartSec=900
