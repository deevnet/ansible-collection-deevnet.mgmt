# {{ ansible_managed }}
# PowerDNS Authoritative - tenant DNS authority (ADR-0004).
#
# Authoritative only. It answers for the tenant zones the core router's Unbound
# delegates to it, and recurses for nothing.

launch=gsqlite3
gsqlite3-database=/var/lib/powerdns/{{ powerdns_db_file }}

local-address={{ powerdns_listen_address }}
local-port={{ powerdns_listen_port }}

# Records are tenant-authored over RFC 2136. Per-zone metadata decides who may
# write: TSIG-ALLOW-DNSUPDATE names the accepted key, ALLOW-DNSUPDATE-FROM the
# permitted source network. A tenant's key is scoped to that tenant's zones,
# which is what makes ADR-0004's "namespaced" constraint a control rather than
# a promise.
dnsupdate={{ 'yes' if powerdns_dnsupdate_enabled else 'no' }}

# ADR-0005: the zone apex belongs to the substrate. Without this, create-zone
# stamps every new zone with `a.misconfigured.dns.server.invalid` as its
# primary - PowerDNS's literal placeholder - which breaks the SOA that a future
# AXFR-fed secondary would use to find its primary.
#
# This governs zones created from now on ONLY; the stored SOA of an existing
# zone is not rewritten by a config change, which is why provision_zones also
# reconciles the apex of zones that already exist.
default-soa-content={{ powerdns_apex_ns }} {{ powerdns_soa_rname }} 0 {{ powerdns_soa_timers }}

# The HTTP API is deliberately NOT enabled. Its key is global to the server, so
# exposing it would hand any holder write access to every tenant's zone - the
# reason ADR-0004 chose RFC 2136 over the API in the first place. Zone and key
# administration is done with pdnsutil, which reads the database directly.

# No secondary exists yet, so nothing should be pulling zones. When one is
# added (the mitigation for this server being a single point of failure for
# tenant names), allow it by IP here rather than opening AXFR generally.
disable-axfr=yes

version-string=anonymous
log-dns-details=no
loglevel=4
