# {{ ansible_managed }}
#
# vmauth's users (ADR-0022 §3, CHG-0018). Root-only: every bearer token at the
# site that can write or read logs is in this file.
#
# Rules this file keeps, each for a reason:
#   - EVERY url_map entry sets BOTH AccountID and ProjectID. VictoriaLogs'
#     default is the substrate partition ("By default the (AccountID=0,
#     ProjectID=0) tenant is queried"), so an entry that forgot them would fail
#     OPEN into substrate logs, not closed. vmauth replaces a caller's header of
#     the same name (updateHeadersByConfig, dst.Set), so a caller cannot pick
#     its own partition.
#   - There is NO unauthorized_user and NO default_url. A request without a
#     known token, or on a path no entry matches, is refused.
#   - The read user may only /select/. There are no ingest users: ADR-0027
#     makes the store tenants-only, and tenant users arrive with tenant tokens.

users:
  # The operator: read only, the substrate partition. One entry per partition
  # is the design (ADR-0022, Q1: no cross-tenant query), but routing between
  # partitions is the tenant-token change's to build, so the role refuses more
  # than one until then.
  - name: "operator-read"
    bearer_token: "{{ victorialogs_vmauth_operator_read_token }}"
    url_map:
{% for p in victorialogs_vmauth_operator_partitions %}
      - src_paths: ["/select/.*"]
        url_prefix: "{{ victorialogs_vmauth_backend }}"
        headers:
          - "AccountID: {{ p.account }}"
          - "ProjectID: {{ p.project }}"
{% endfor %}
